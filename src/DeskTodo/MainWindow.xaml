<Window x:Class="DeskTodo.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:DeskTodo.Core;assembly=DeskTodo.Core"
        Title="桌面待办" Width="392" Height="632" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="Manual"
        AutomationProperties.Name="桌面待办">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
    <Style x:Key="Tab" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Height" Value="34"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="TabSurface" CornerRadius="4" Background="Transparent" Padding="4,6">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#E5F2EF"/><Setter Property="Foreground" Value="#14695F"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Opacity" Value="0.7"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="TabSurface" Property="BorderThickness" Value="1"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="TaskRow">
      <Border BorderBrush="#EDF0F1" BorderThickness="0,0,0,1" Padding="0,11">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
          <CheckBox x:Name="Complete" IsChecked="{Binding IsCompleted, Mode=OneWay}" Click="Complete_Click"
                    VerticalAlignment="Top" Margin="0,3,0,0" AutomationProperties.Name="{Binding AccessibleTitle}" ToolTip="标记完成或撤销完成"/>
          <Button x:Name="Restore" Visibility="Collapsed" Style="{StaticResource IconButton}" Content="&#xE777;"
                  Click="Restore_Click" ToolTip="恢复任务" AutomationProperties.Name="恢复任务" VerticalAlignment="Top"/>
          <StackPanel Grid.Column="1" Margin="0,0,6,0">
            <TextBlock x:Name="TaskTitle" Text="{Binding Title}" FontSize="13" Foreground="{StaticResource Ink}"/>
            <TextBlock x:Name="Notes" Text="{Binding Notes}" Foreground="{StaticResource Muted}" FontSize="11"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxHeight="18" Margin="0,3,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
              <TextBlock Text="{Binding DateLabel}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Border x:Name="PriorityBadge" Background="#FFF3D6" CornerRadius="3" Padding="5,2">
                <TextBlock x:Name="PriorityText" Text="{Binding PriorityLabel}" Foreground="#805C16" FontSize="10"/>
              </Border>
            </StackPanel>
          </StackPanel>
          <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE712;" Click="TaskMenu_Click"
                  VerticalAlignment="Top" ToolTip="任务操作" AutomationProperties.Name="任务操作">
            <Button.ContextMenu>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Opened="TaskContextMenu_Opened">
                <MenuItem x:Name="EditMenu" Header="编辑 / 改期" Click="Edit_Click"/>
                <MenuItem x:Name="DeleteMenu" Header="移入回收站" Click="Delete_Click"/>
                <MenuItem x:Name="RestoreMenu" Header="恢复任务" Click="Restore_Click" Visibility="Collapsed"/>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Priority}" Value="{x:Static core:TodoPriority.Urgent}"><Setter TargetName="PriorityBadge" Property="Background" Value="#FDE8EA"/><Setter TargetName="PriorityText" Property="Foreground" Value="#AB3345"/></DataTrigger>
        <DataTrigger Binding="{Binding Priority}" Value="{x:Static core:TodoPriority.Relaxed}"><Setter TargetName="PriorityBadge" Property="Background" Value="#E8F1FB"/><Setter TargetName="PriorityText" Property="Foreground" Value="#356791"/></DataTrigger>
        <DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter TargetName="TaskTitle" Property="TextDecorations" Value="Strikethrough"/><Setter TargetName="TaskTitle" Property="Foreground" Value="#8A737D"/></DataTrigger>
        <DataTrigger Binding="{Binding Notes}" Value=""><Setter TargetName="Notes" Property="Visibility" Value="Collapsed"/></DataTrigger>
        <DataTrigger Binding="{Binding IsDeleted}" Value="True"><Setter TargetName="Complete" Property="Visibility" Value="Collapsed"/><Setter TargetName="Restore" Property="Visibility" Value="Visible"/></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>
  <Border x:Name="Surface" Margin="8" Background="White" BorderBrush="#DCE3E5" BorderThickness="1" CornerRadius="8">
    <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.14" Color="#16282D"/></Border.Effect>
    <Grid>
      <Grid x:Name="Panel">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="18,14,12,10" MouseLeftButtonDown="DragHeader">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="桌面待办" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding DateLabel}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
            <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="&#xE718;" Click="Pin_Click" ToolTip="切换始终置顶" AutomationProperties.Name="切换始终置顶"/>
            <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE713;" Click="Settings_Click" ToolTip="设置" AutomationProperties.Name="设置"/>
            <Button x:Name="CollapseButton" Style="{StaticResource IconButton}" Content="&#xE70D;" Click="Collapse_Click" ToolTip="收起面板" AutomationProperties.Name="收起面板"/>
          </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Margin="18,0,18,13">
          <Grid><TextBlock Text="{Binding FooterLabel}" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding ProgressLabel}" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource Accent}"/></Grid>
          <ProgressBar Value="{Binding Summary.Percent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,8,0,0" Foreground="{StaticResource Accent}" Background="#EAF0EF" BorderThickness="0" AutomationProperties.Name="今日完成进度"/>
        </StackPanel>
        <Grid Grid.Row="2" Margin="12,0,12,12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <RadioButton x:Name="TodayTab" Style="{StaticResource Tab}" Content="今日" GroupName="View" IsChecked="True" Tag="Today" Checked="View_Checked"/>
          <RadioButton x:Name="FutureTab" Grid.Column="1" Style="{StaticResource Tab}" Content="未来" GroupName="View" Tag="Future" Checked="View_Checked"/>
          <RadioButton x:Name="HistoryTab" Grid.Column="2" Style="{StaticResource Tab}" Content="记录" GroupName="View" Tag="History" Checked="View_Checked"/>
          <RadioButton x:Name="TrashTab" Grid.Column="3" Style="{StaticResource Tab}" Content="回收站" GroupName="View" Tag="Trash" Checked="View_Checked"/>
        </Grid>
        <StackPanel Grid.Row="3">
          <Grid x:Name="AddArea" Margin="18,0,18,8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
            <Grid>
              <TextBox x:Name="QuickTitle" MaxLength="240" KeyDown="QuickTitle_KeyDown" MinHeight="38" AutomationProperties.Name="新任务名称"/>
              <TextBlock x:Name="QuickPlaceholder" Text="添加今天要做的事…" Margin="11,0,0,0" VerticalAlignment="Center" Foreground="#879399" IsHitTestVisible="False">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=QuickTitle}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
            </Grid>
            <Button x:Name="AddButton" Grid.Column="1" Style="{StaticResource IconButton}" Background="{StaticResource Accent}" Foreground="White" Content="&#xE710;" Height="36" Margin="4,0,0,0" Click="Add_Click" ToolTip="添加到今天" AutomationProperties.Name="添加到今天"/>
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE70F;" Height="36" Margin="4,0,0,0" Click="NewDetails_Click" ToolTip="添加任务并选择日期" AutomationProperties.Name="添加任务并选择日期"/>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,0">
              <TextBlock Text="紧急程度" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ComboBox x:Name="QuickPriority" Width="96" Height="28" SelectedIndex="1" AutomationProperties.Name="新任务紧急程度">
                <ComboBoxItem Content="急急急"/><ComboBoxItem Content="抓点紧"/><ComboBoxItem Content="不慌"/>
              </ComboBox>
            </StackPanel>
          </Grid>
          <DatePicker x:Name="HistoryPicker" Visibility="Collapsed" SelectedDate="{Binding HistoryDate, Mode=TwoWay}" Margin="18,0,18,8" AutomationProperties.Name="完成记录日期"/>
        </StackPanel>
        <Grid Grid.Row="4">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,0,18,8">
            <ItemsControl x:Name="TaskSections" ItemsSource="{Binding Sections}">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Expander IsExpanded="True" Margin="0,10,0,0" HorizontalContentAlignment="Stretch">
                  <Expander.Header><TextBlock Text="{Binding Title}" FontSize="11" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/></Expander.Header>
                  <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TaskRow}" Margin="0,3,0,0"/>
                </Expander>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
            <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26" Foreground="#A5B7B3" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding EmptyLabel}" Foreground="{StaticResource Muted}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
        <Border Grid.Row="5" Background="#F1F6F5" Padding="14,7" MinHeight="34">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource Accent}" FontSize="11" VerticalAlignment="Center"/>
            <Button x:Name="UndoButton" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE7A7;" Height="24" Click="Undo_Click" IsEnabled="{Binding CanUndo}" ToolTip="撤销上一步" AutomationProperties.Name="撤销上一步"/>
          </Grid>
        </Border>
        <Grid Grid.Row="6" Margin="18,8,12,8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="SaveLabel" Text="本地保存" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE738;" Height="22" Click="Hide_Click" ToolTip="隐藏到托盘" AutomationProperties.Name="隐藏到托盘"/>
        </Grid>
      </Grid>
      <Grid x:Name="Chip" Visibility="Collapsed" Background="Transparent" MouseLeftButtonDown="Chip_MouseDown" ToolTip="展开今日待办">
        <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
        <TextBlock Text="&#xE73A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="待办" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="{Binding CountLabel}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
      </Grid>
    </Grid>
  </Border>
</Window>
