<Window x:Class="DeskTodo.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="设置" Width="380" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="22">
    <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20"/>
    <CheckBox x:Name="TopmostToggle" Content="始终置顶" Margin="0,0,0,16" Click="Topmost_Click"/>
    <CheckBox x:Name="FullscreenToggle" Content="全屏时自动隐藏" Margin="0,0,0,16" Click="Fullscreen_Click"/>
    <CheckBox x:Name="StartupToggle" Content="开机启动" Margin="0,0,0,20" Click="Startup_Click"/>
    <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,18"/>
    <TextBlock Text="数据与备份" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Button Content="导出备份" Click="Export_Click" Margin="0,0,5,0"/>
      <Button Grid.Column="1" Content="恢复备份" Click="Import_Click" Margin="5,0,0,0"/>
    </Grid>
    <Button Content="打开数据文件夹" Click="Folder_Click" Margin="0,10,0,0"/>
    <TextBlock x:Name="DataPathLabel" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
    <TextBlock x:Name="StatusLabel" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,14,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="退出应用" Click="Exit_Click" Margin="0,0,8,0"/>
      <Button Content="关闭" IsCancel="True" Style="{StaticResource PrimaryButton}"/>
    </StackPanel>
  </StackPanel>
</Window>
